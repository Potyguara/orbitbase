# Copie para deploy/.env (o install.sh faz isso e gera SECRET_KEY sozinho).
APP_ENV=production
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://orbitbase.biomereurb.com.br

# Credenciais NASA Earthdata padrão do servidor (opcional).
# Usadas no modo avançado quando o usuário não cadastrou as próprias no perfil.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Limites de recursos (opcional)
# ORBITBASE_CPUS=0.75
# ORBITBASE_MEM=1800m
# ORBITBASE_PORT=8088
